# ============================================================
# WeChat AI Agent — LLM 配置
# 复制此文件为 .env 并填入 API Key
# cp .env.example .env
# ============================================================

# ---- 快捷配置（三任务共用 DeepSeek，推荐）----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 分任务配置（可选，覆盖上方默认值）----
# LLM_CHAT_PROVIDER=deepseek
# LLM_CHAT_API_KEY=sk-your-deepseek-key
# LLM_CHAT_MODEL=deepseek-chat
# LLM_CHAT_TEMPERATURE=0.85

# LLM_MEMORY_PROVIDER=deepseek
# LLM_MEMORY_API_KEY=sk-your-deepseek-key
# LLM_MEMORY_MODEL=deepseek-chat
# LLM_MEMORY_TEMPERATURE=0.3

# LLM_PROFILE_PROVIDER=deepseek
# LLM_PROFILE_API_KEY=sk-your-deepseek-key
# LLM_PROFILE_MODEL=deepseek-chat

# ---- 其他 Provider（可选）----
# QWEN_API_KEY=sk-xxx          → 通义千问
# MOONSHOT_API_KEY=sk-xxx      → Kimi
# GLM_API_KEY=xxx              → 智谱

# ---- 通用参数 ----
# LLM_TIMEOUT=30

# 本地 Docker 网关鉴权（deploy.ps1 缺失时会自动生成）
# LLM_GATEWAY_TOKEN=请使用至少32字节随机值

# 隐私调试开关（默认全部关闭）
# WECHAT_SAVE_DEBUG_PROMPT=1
# WECHAT_LOG_CONTENT=1
# WECHAT_AUDIT_LOG=1
# WECHAT_VERBOSE_MEMORY=1
# WECHAT_SHOW_CONTENT=1

# 个人知识库最低相似度（0~1，越高越严格）
# WECHAT_KNOWLEDGE_MIN_SCORE=0.35

# ============================================================
# 推荐: 全部 DeepSeek（chat + memory + profile）
# ============================================================
