# 复制为项目根目录 .env 后使用
# cp docker/.env.example ../.env

# DeepSeek（网关容器和 Windows Agent 都会读取）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# 网关容器转发上游地址（一般不用改）
DEEPSEEK_UPSTREAM_URL=https://api.deepseek.com

# Windows Agent 连接本地 Docker 网关（启用网关时使用）
# DEEPSEEK_BASE_URL=http://localhost:8000

# Docker 映射端口
LLM_GATEWAY_PORT=8000

# 网关 Bearer Token（至少32字节随机值）
LLM_GATEWAY_TOKEN=replace-with-a-long-random-token
